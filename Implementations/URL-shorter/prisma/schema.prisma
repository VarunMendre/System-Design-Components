generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccessMode {
  PRIVATE
  SHARED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  links        Link[]
}

model Link {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  originalUrl  String
  shortCode    String      @unique
  accessMode   AccessMode  @default(PRIVATE)
  isCustomAlias Boolean    @default(false)
  isActive     Boolean     @default(true)
  deletedAt    DateTime?
  expiresAt    DateTime?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([shortCode])
  @@index([deletedAt])
}